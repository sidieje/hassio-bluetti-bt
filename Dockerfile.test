# Pinned to match the interpreter in .github/workflows/test.yml. 'python:3'
# silently tracks whatever the runner ships, so the container and CI could run
# the same suite on different interpreters.
FROM python:3.13

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY tests ./tests
COPY custom_components/bluetti_bt ./custom_components/bluetti_bt

RUN python3 -m unittest discover -s tests -p "*.py"
